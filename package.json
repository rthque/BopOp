{
  "name": "bopop",
  "version": "1.0.0",
  "private": true,
  "description": "BOP works tracker for the Dieppe Le Treport wind farm. Static site, no build step.",
  "scripts": {
    "dev": "node scripts/serve.js",
    "test": "npm run test:unit && playwright test",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:browser": "playwright test",
    "test:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  }
}
